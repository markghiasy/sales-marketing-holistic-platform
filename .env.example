# Copy to .env, fill in, never commit the filled-in version.
# Per build plan §5 rule 1: every token, tenant id, app id, mailbox address
# comes from here or a secret store — never from source, a migration, or a
# seed file.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
OUTLOOK_MAILBOX=

LINKEDIN_SELF_PROFILE_URL=
# ^ e.g. https://www.linkedin.com/in/evang2 — your own profile URL as it
# appears in messages.csv's SENDER/RECIPIENT PROFILE URL columns, used by
# the data-export sync (export_sync.py) to tell your own messages apart
# from everyone else's. The network-interception path (client.py/sync.py)
# doesn't need this or any other configured id — it reads "who am I"
# straight out of LinkedIn's own response payloads.
# Rate/volume limits — §13 rule 2: fixed, needs Mark's written sign-off to
# change. These defaults are an unconfirmed placeholder, not agreed numbers.
LINKEDIN_MIN_DELAY_S=3.0
LINKEDIN_MAX_DELAY_S=8.0
LINKEDIN_MAX_PAGES_PER_SESSION=20
LINKEDIN_MAX_SESSIONS_PER_DAY=4

DATABASE_URL=postgresql://comms:comms@localhost:5432/comms
POSTGRES_USER=comms
POSTGRES_PASSWORD=comms
POSTGRES_DB=comms
# POSTGRES_PORT=5432   # only needed if 5432 is already taken on this
                        # machine (e.g. running a second instance
                        # alongside one that's already up) — must match
                        # the port in DATABASE_URL above if changed

# WhatsApp auth-state encryption key — 32 random bytes as base64.
# Generate with: openssl rand -base64 32
WHATSAPP_AUTH_ENCRYPTION_KEY=

# scripts/monitor.py alerting — ntfy.sh, no account needed. The topic name
# is a shared secret (anyone who knows it can read your alerts and post
# fake ones), so use a long random string, not something guessable.
# Subscribe on your phone/desktop: https://ntfy.sh/<topic>
MONITOR_NTFY_TOPIC=
# Optional Slack-style webhook, layered on top if set — nothing uses this
# right now.
MONITOR_ALERT_WEBHOOK_URL=
